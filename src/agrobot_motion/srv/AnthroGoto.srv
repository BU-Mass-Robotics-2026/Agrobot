# AnthroGoto.srv
# Move the anthro group (arm joints J1-J5) to an absolute joint-space target.
# The caller supplies 5 joint values in RADIANS, ordered [J1, J2, J3, J4, J5].
#
# This is the arm-side sibling of RailGoto. It is used by the celebration
# emote now, and is the intended primitive for the future arm-pick service.

# --- Request ---
float64[] joint_positions   # Exactly 5 values, radians, ordered [J1,J2,J3,J4,J5].
float64   velocity_scaling  # 0.0 to 1.0. If <= 0, the node's default param is used.
                            # Wrong-length requests are rejected (success=false).
---
# --- Response ---
bool success                # true  = MoveIt planned AND executed to target
                            # false = bad request, planning failed, or exec failed
float64[] final_positions   # Actual J1-J5 joint values after the call (radians)
string message              # Human-readable result / failure reason

# syntax=docker/dockerfile:1.7
###############################################################################
# Dockerfile.rocm-gpu — GPU-enabled perception image for gfx1151 (Strix Halo)
#
# DIFFERENCE FROM Dockerfile.rocm:
#   Dockerfile.rocm builds ROCm + a +rocm7.0 PyTorch wheel on plain ubuntu:24.04.
#   That wheel page-faults on gfx1151 (verified 2026-05-20). This file instead
#   bases on AMD's VALIDATED container, which ships torch 2.9.1+rocm7.2.1 — the
#   exact stack proven to run zeros/matmul/Conv2d on gfx1151 without faulting.
#   ROS 2 Jazzy + perception deps are layered ON TOP of that known-good base.
#
#   Base OS of rocm/pytorch:rocm7.2.1_ubuntu24.04_... is Ubuntu 24.04, so
#   ROS 2 Jazzy (which requires 24.04 / noble) installs cleanly.
#
# Build (on the NucBox, from repo root):
#   docker build \
#     --file deployment/docker/Dockerfile.rocm-gpu \
#     --tag agrobot-tom-v2/rocm-gpu:latest \
#     .
#
# This does NOT overwrite agrobot-tom-v2/rocm:latest (the CPU image). Both
# coexist; run_rocm.sh picks via the IMAGE env var.
###############################################################################

FROM rocm/pytorch:rocm7.2.1_ubuntu24.04_py3.12_pytorch_release_2.9.1 AS base

ENV DEBIAN_FRONTEND=noninteractive

# ── ROS 2 Jazzy ───────────────────────────────────────────────────────────────
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu noble main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-base \
    ros-jazzy-cv-bridge \
    ros-jazzy-image-transport \
    ros-jazzy-vision-msgs \
    ros-jazzy-realsense2-camera \
    python3-colcon-common-extensions \
    git tmux htop vim \
    && rm -rf /var/lib/apt/lists/*

# ── Perception Python deps ────────────────────────────────────────────────────
# CRITICAL: the rocm/pytorch base image keeps its Python (and the verified-good
# torch 2.9.1+rocm7.2.1) in a venv at /opt/venv — NOT system Python. Perception
# deps MUST install into that same venv or the nodes cannot import torch.
# (Verified 2026-05-22: the earlier `pip3 --break-system-packages` installed to
# system Python and every perception node failed with ModuleNotFoundError.)
#
# numpy<2 is pinned LAST: cv_bridge is built against the numpy 1.x ABI and
# segfaults under numpy 2.x, which torch otherwise pulls in.
RUN /opt/venv/bin/pip install --no-cache-dir \
    sam2 \
    hydra-core iopath \
    scipy \
    transformers sentencepiece protobuf qwen-vl-utils Pillow \
    opencv-python-headless \
    'numpy<2' \
    'setuptools<80'

# ── Environment ───────────────────────────────────────────────────────────────
WORKDIR /workspace
RUN mkdir -p /ros2_ws/src

ENV ROS_DOMAIN_ID=0
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ENV PATH=/opt/venv/bin:/opt/rocm/bin:${PATH}

# HSA_OVERRIDE_GFX_VERSION: safety fallback — ROCm 7.2.1 auto-detects gfx1151
# on kernel 6.17.0-1023-oem, but this guards against ISA misdetection if the
# kernel or driver ever changes. Do NOT use 11.0.x — those target gfx1100
# (discrete RDNA 3) and SIGBUS on gfx1151's unified memory controller.
ENV HSA_OVERRIDE_GFX_VERSION=11.5.1

# GPU_MAX_HW_QUEUES: 8 CU clusters on Strix Halo — maximises parallelism for
# concurrent DINOv2 + SAM2 inference streams.
ENV GPU_MAX_HW_QUEUES=8

# HSA_ENABLE_SDMA=0: SDMA overhead is higher than CPU memcpy on unified memory
# (no discrete VRAM). Forces ROCm to use CPU-side blit copies instead.
ENV HSA_ENABLE_SDMA=0

RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc

# entrypoint.sh is copied if present; falls back to bash otherwise.
COPY deployment/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh || true

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

# syntax=docker/dockerfile:1.7
###############################################################################
# Dockerfile.rocm — AMD Edge Deployment (NucBox / GMKtec EVO-X2)
#
# Hardware   : AMD Ryzen AI Max+ 395 (Strix Halo), Radeon 8060S, 96GB unified RAM
# GPU arch   : gfx1151 (RDNA 3.5)
# Target OS  : linux/amd64, Ubuntu 24.04, kernel >= 6.14 (OEM: 6.17.0-1023-oem)
# ROCm       : 7.2.1 (via AMD validated container)
#
# Base image: rocm/pytorch:rocm7.2.1_ubuntu24.04_py3.12_pytorch_release_2.9.1
#   Includes: ROCm 7.2.1 full stack, PyTorch 2.9.1+rocm7.2.1, torchvision,
#             torchaudio, MIGraphX, rocm-smi. ABI-matched to the 7.2.1 runtime.
#
# Why NOT ubuntu:24.04 + pip rocm7.0 wheels (prior approach):
#   torch+rocm7.0 wheels segfault against the ROCm 7.2.1 runtime on the host
#   due to a HIP ABI mismatch (confirmed 2026-05-20). AMD's validated container
#   is the only clean path to GPU compute on gfx1151.
#
# Why NOT building ROCm from the AMD apt repo:
#   The host driver fix (purge amdgpu-dkms + stale MES firmware) that enabled
#   GPU compute is host-side. The container only needs the matching userspace
#   libraries, which AMD's container provides pre-built.
#
# GPU enablement prerequisite (host, one-time):
#   Purge amdgpu-dkms + stale /lib/firmware/updates/amdgpu/ override,
#   reinstall linux-firmware, boot OEM kernel 6.17.0-1023-oem.
#   See docs/SPRINT3_ROCM_ISSUE.md for the full procedure.
#
# Build (run on AMD edge machine, NOT your Mac):
#   docker build \
#     --file deployment/docker/Dockerfile.rocm \
#     --tag agrobot-tom-v2/rocm:latest \
#     .
#
# Run (use script so host GPU GIDs are applied dynamically):
#   ./deployment/docker/run_rocm.sh [bash]
###############################################################################

FROM rocm/pytorch:rocm7.2.1_ubuntu24.04_py3.12_pytorch_release_2.9.1

ENV DEBIAN_FRONTEND=noninteractive

# ── ROS 2 Jazzy ───────────────────────────────────────────────────────────────
# AMD base is Ubuntu 24.04 (Noble) — Jazzy is the matching ROS 2 distro.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu noble main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-base \
    ros-jazzy-cv-bridge \
    ros-jazzy-image-transport \
    ros-jazzy-vision-msgs \
    ros-jazzy-realsense2-camera \
    python3-colcon-common-extensions \
    python3-dev \
    git \
    tmux \
    htop \
    vim \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps not in AMD base ────────────────────────────────────────────────
# torch / torchvision / torchaudio / migraphx are already in the base image.
# sam2: Meta's Segment Anything Model 2 (mask proposals for tomato detection).
# hydra-core / iopath: used by SAM2's training scripts.
# datasets: HuggingFace dataset loading (Laboro Tomato / KUTomaData).
# scipy: Hungarian algorithm (linear_sum_assignment) for tomato_tracker.
# transformers + qwen-vl-utils: Qwen2.5-VL ripeness inference in qwen_vl node.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    sam2 && \
    pip install \
    hydra-core iopath datasets onnx tqdm && \
    pip install \
    scipy transformers sentencepiece qwen-vl-utils opencv-python-headless

# ── Workspace + ROS 2 environment ─────────────────────────────────────────────
WORKDIR /workspace
RUN mkdir -p /ros2_ws/src

ENV ROS_DOMAIN_ID=42
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ENV PATH=/opt/rocm/bin:${PATH}

# ── gfx1151 (Strix Halo / RDNA 3.5) GPU tuning ───────────────────────────────
#
# HSA_OVERRIDE_GFX_VERSION: safety fallback — ROCm 7.2.1 auto-detects gfx1151
# on kernel 6.17.0-1023-oem, but this ensures correct ISA if detection fails.
# Do NOT use 11.0.0/11.0.2/11.0.3 — those target gfx1100 (discrete RDNA 3)
# and cause SIGBUS on gfx1151's unified memory controller.
ENV HSA_OVERRIDE_GFX_VERSION=11.5.1

# GPU_MAX_HW_QUEUES: 8 CU clusters on Strix Halo — maximises parallelism for
# concurrent DINOv2 + SAM2 inference streams.
ENV GPU_MAX_HW_QUEUES=8

# HSA_ENABLE_SDMA=0: SDMA overhead is higher than CPU memcpy on unified memory
# (no discrete VRAM). Forces ROCm to use CPU-side blit copies instead.
ENV HSA_ENABLE_SDMA=0

RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc

COPY deployment/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
